# ============================================================================
# Techno Spiritual Hackathon 2026 - PostgreSQL Database Environment Variables
# ============================================================================

# Connection string (Use this OR individual variables below)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/tsh_hackathon

# Individual credentials (used if DATABASE_URL is not provided)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=tsh_hackathon

# SSL Mode (require for Supabase / Neon / AWS RDS, disable for local docker)
PGSSL=false
